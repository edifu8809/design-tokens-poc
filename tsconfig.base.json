{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "importHelpers": true,
    "declaration": false,
    "sourceMap": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@design-tokens-poc/shared/design-tokens": [
        "./libs/shared/design-tokens/src/index.ts"
      ],
      "@design-tokens-poc/shared/ui": ["./libs/shared/ui/src/index.ts"]
    }
  }
}
